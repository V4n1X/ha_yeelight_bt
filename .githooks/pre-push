#!/bin/sh
# Refuse pushes whose new commits contain personal data, including commit
# messages and author details (see scripts/check_private_data.py)
PY=$(command -v python3 || command -v python)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    # new branch: check the commits not yet on any remote branch
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  "$PY" scripts/check_private_data.py --range "$range" || status=1
done
exit $status
